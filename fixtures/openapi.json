            "additionalProperties": {
              "type": "string"
            }
          },
          "method": {
            "type": "string"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "monthlyHours": {
            "type": "number"
          },
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "frequency": {
                  "type": "string",
                  "enum": [
                    "weekly",
                    "biweekly",
                    "monthly"
                  ]
                },
                "day": {
                  "type": "string",
                  "enum": [
                    "MO",
                    "TU",
                    "WE",
                    "TH",
                    "FR",
                    "SA",
                    "SU"
                  ]
                },
                "monthday": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 28
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "time": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "owner": {
                  "type": "string",
                  "enum": [
                    "delegate",
                    "keep",
                    "decide"
                  ]
                },
                "firstDate": {
                  "type": "string",
                  "format": "date"
                },
                "recurrenceRule": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "frequency",
                "day",
                "monthday",
                "minutes",
                "time",
                "owner",
                "firstDate",
                "recurrenceRule"
              ],
              "additionalProperties": false
            }
          },
          "ics": {
            "type": "string",
            "description": "RFC 5545 calendar with CRLF folding and floating local times."
          }
        },
        "required": [
          "tool",
          "input",
          "units",
          "method",
          "assumptions",
          "provenance",
          "monthlyHours",
          "schedules",
          "ics"
        ],
        "additionalProperties": false
      }
