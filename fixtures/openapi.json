{
  "openapi": "3.1.0",
  "info": {
    "title": "OperatorNest public tool API",
    "version": "1.0.0",
    "description": "Three stateless deterministic calculations and a read-only model catalog. No authentication, model inference, storage or calendar submission. Inputs and results have bounded documented schemas."
  },
  "servers": [
    {
      "url": "https://operatornest.com"
    }
  ],
  "externalDocs": {
    "url": "https://operatornest.com/tools/api"
  },
  "paths": {
    "/api/tools/ai-api-cost-calculator": {
      "post": {
        "operationId": "ai_api_cost_calculator",
        "summary": "Calculate ai api cost calculator",
        "requestBody": {
          "required": true,
          "description": "UTF-8 JSON, at most 32768 bytes.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ai-api-cost-calculator-input"
              },
              "example": {
                "inputTokens": 10000,
                "cachedInputTokens": 5000,
                "outputTokens": 2000,
                "requestsPerDay": 100,
                "requestsPerMonth": 3000,
                "modelIds": [
                  "anthropic/claude-opus-5-5"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculation result with normalized input, units, method, assumptions and provenance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ai-api-cost-calculator-result"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or unreadable request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_json",
                    "message": "Send valid UTF-8 JSON."
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 32768 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "body_too_large",
                    "message": "JSON body must be at most 32768 bytes."
                  }
                }
              }
            }
          },
          "415": {
            "description": "Unsupported request media type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "unsupported_media_type",
                    "message": "Send application/json."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid bounded input, model ID, timezone or date. Field identifies the input to correct.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_input",
                    "message": "Cached tokens cannot exceed input tokens."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected calculation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "calculation_failed",
                    "message": "Calculation unavailable. Try again."
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Unsupported method",
        "responses": {
          "405": {
            "description": "Use POST.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "method_not_allowed",
                    "message": "Use POST for this tool."
                  }
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "const": "POST"
                }
              }
            }
          }
        }
      }
    },
